# PostgreSQL connection string (required)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=

# Cloudinary media storage (required for admin uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed browser origins (CORS):
# CORS_ORIGINS=http://localhost:5173,https://www.pip-dev.in,https://pip-found.pages.dev

# Razorpay (leave blank to use test-mode mock orders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin API basic auth credentials (override defaults)
# ADMIN_USER=
# ADMIN_PASSWORD=

# SMTP email (used to email the volunteer welcome card on acceptance)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=            (defaults to SMTP_USER when blank)
# SMTP_FROM_NAME=Piplad Welfare Foundation
# SMTP_SSL=false        (true => use SMTP_SSL, typically port 465)
# SMTP_STARTTLS=true    (false => plain SMTP for local testing)
# SMTP_NO_AUTH=false    (true => skip SMTP login)